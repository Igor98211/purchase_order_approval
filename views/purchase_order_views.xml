<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_large_order" model="ir.ui.view">
        <field name="name">purchase.order.form.large.order</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="tax_totals" position="after">
                <div colspan="2" class="o_po_large_order">
                    <label for="large_order" string="Large Order"/>
                    <field name="large_order" nolabel="1"/>
                </div>
            </field>
        </field>
    </record>
</odoo>
